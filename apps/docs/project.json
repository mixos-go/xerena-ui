{
  "name": "docs",
  "projectType": "application",
  "sourceRoot": "apps/docs",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "next dev", "cwd": "apps/docs" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "next build", "cwd": "apps/docs" },
      "outputs": ["{projectRoot}/out"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.json --noEmit", "cwd": "apps/docs" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint .", "cwd": "apps/docs" }
    }
  }
}
